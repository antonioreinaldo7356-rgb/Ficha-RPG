    <!-- Lógica da Aplicação JavaScript -->
    <script>
        // -- ESTADO & REGRAS OFICIAIS DO PDF --
        const STORAGE_KEY = 'assassino_verde_v2_state';
        const MAX_HP = 85;
        const STR_MOD = 5;      // FOR 20 (+5)
        const PROF_BONUS = 3;   // Bárbaro Nível 8 (+3)
        const HIT_BONUS = 8;     // +8 (+5 FOR + 3 Profic)
        
        let state = {
            hp: 85,
            tempHp: 0,
            rage: [false, false, false, false], // true = ativa/gasta
            hd: [false, false, false, false, false, false, false, false], // true = gasto
            javelins: 4,
            deathSaves: { s: [false, false, false], f: [false, false, false] }
        };

        function loadState() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    if (typeof parsed.hp === 'number') state.hp = parsed.hp;
                    if (typeof parsed.tempHp === 'number') state.tempHp = parsed.tempHp;
                    if (Array.isArray(parsed.rage)) state.rage = parsed.rage;
                    if (Array.isArray(parsed.hd)) state.hd = parsed.hd;
                    if (typeof parsed.javelins === 'number') state.javelins = parsed.javelins;
                    if (parsed.deathSaves) state.deathSaves = parsed.deathSaves;
                } catch (e) {
                    console.error("Erro ao carregar estado salvo", e);
                }
            }
            updateUI();
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
            updateUI();
        }

        // -- ATUALIZAÇÕES DE INTERFACE --
        function updateUI() {
            // PV e Barra Visual
            document.getElementById('current-hp-display').innerText = state.hp;
            document.getElementById('temp-hp-display').innerText = state.tempHp;
            
            const hpPercent = Math.max(0, Math.min(100, (state.hp / MAX_HP) * 100));
            const hpBar = document.getElementById('hp-bar');
            hpBar.style.width = `${hpPercent}%`;
            
            const hpDisplay = document.getElementById('current-hp-display');
            const deathBox = document.getElementById('death-saves-box');

            if (state.hp === 0) {
                hpDisplay.className = "text-5xl font-bold text-red-500 drop-shadow-md";
                hpBar.className = "h-full bg-red-600 transition-all duration-500 ease-out";
                deathBox.classList.remove('hidden');
            } else if (state.hp <= Math.floor(MAX_HP / 4)) {
                hpDisplay.className = "text-5xl font-bold text-amber-400 drop-shadow-md";
                hpBar.className = "h-full bg-gradient-to-r from-red-600 to-amber-500 transition-all duration-500 ease-out";
                deathBox.classList.add('hidden');
            } else {
                hpDisplay.className = "text-5xl font-bold text-white drop-shadow-md";
                hpBar.className = "h-full bg-gradient-to-r from-emerald-700 to-emerald-400 transition-all duration-500 ease-out";
                deathBox.classList.add('hidden');
            }

            // Atualiza Fúria
            const rageContainer = document.getElementById('rage-container');
            rageContainer.innerHTML = '';
            let isRaging = false;
            
            state.rage.forEach((isUsed, index) => {
                const dot = document.createElement('div');
                dot.className = `resource-dot ${isUsed ? 'active' : 'used'}`;
                if (isUsed) isRaging = true; 
                
                dot.innerHTML = `<i class="fa-solid fa-fire"></i>`;
                dot.onclick = () => {
                    state.rage[index] = !state.rage[index];
                    saveState();
                };
                rageContainer.appendChild(dot);
            });

            const rageBadge = document.getElementById('rage-status-badge');
            const rageTag = document.getElementById('machado-rage-tag');
            const machadoDmg = document.getElementById('machado-dmg-text');

            if (isRaging) {
                rageBadge.innerText = "ATIVA (+2 DANO)";
                rageBadge.className = "text-[0.65rem] px-2 py-0.5 rounded font-bold bg-amber-500/20 text-amber-400 border border-amber-500/40";
                rageTag.classList.remove('hidden');
                machadoDmg.innerText = "1d10 + 7";
            } else {
                rageBadge.innerText = "INATIVA";
                rageBadge.className = "text-[0.65rem] px-2 py-0.5 rounded font-bold bg-slate-900 text-slate-400";
                rageTag.classList.add('hidden');
                machadoDmg.innerText = "1d10 + 5";
            }

            // Atualiza Dados de Vida
            const hdContainer = document.getElementById('hd-container');
            hdContainer.innerHTML = '';
            let availableHD = 0;
            state.hd.forEach((isUsed, index) => {
                if (!isUsed) availableHD++;
                const dot = document.createElement('div');
                dot.className = `resource-dot w-8 h-8 rounded-lg ${!isUsed ? 'active' : 'used'}`;
                dot.innerHTML = `<i class="fa-solid fa-dice-d20"></i>`;
                dot.onclick = () => {
                    state.hd[index] = !state.hd[index];
                    saveState();
                };
                hdContainer.appendChild(dot);
            });
            document.getElementById('hd-counter-text').innerText = `${availableHD} disponíveis`;

            // Atualiza Azagaias
            const javContainer = document.getElementById('javelin-dots');
            javContainer.innerHTML = '';
            for (let i = 0; i < 4; i++) {
                const dot = document.createElement('span');
                const isAvailable = i < state.javelins;
                dot.className = `w-4 h-4 rounded-full border cursor-pointer ${isAvailable ? 'bg-emerald-500 border-emerald-400' : 'bg-transparent border-slate-600'}`;
                dot.onclick = () => {
                    state.javelins = isAvailable ? i : i + 1;
                    saveState();
                };
                javContainer.appendChild(dot);
            }

            // Atualiza Testes Contra a Morte
            renderDeathSaves();
        }

        function renderDeathSaves() {
            const sContainer = document.getElementById('death-successes').children;
            const fContainer = document.getElementById('death-failures').children;

            for (let i = 0; i < 3; i++) {
                sContainer[i].className = `w-5 h-5 rounded-full border cursor-pointer flex items-center justify-center text-xs ${state.deathSaves.s[i] ? 'bg-emerald-500 border-emerald-400 text-slate-950 font-bold' : 'border-emerald-700 bg-slate-900'}`;
                sContainer[i].innerHTML = state.deathSaves.s[i] ? '✓' : '';

                fContainer[i].className = `w-5 h-5 rounded-full border cursor-pointer flex items-center justify-center text-xs ${state.deathSaves.f[i] ? 'bg-red-500 border-red-400 text-white font-bold' : 'border-red-700 bg-slate-900'}`;
                fContainer[i].innerHTML = state.deathSaves.f[i] ? '✗' : '';
            }
        }

        function toggleDeathSave(type, index) {
            state.deathSaves[type][index] = !state.deathSaves[type][index];
            saveState();
        }

        // -- MANIPULAÇÃO DE VIDA --
        function modifyHP(amount) {
            if (amount < 0) {
                // Aplica dano primeiro em PV Temporários se houver
                let damage = Math.abs(amount);
                if (state.tempHp > 0) {
                    if (state.tempHp >= damage) {
                        state.tempHp -= damage;
                        damage = 0;
                    } else {
                        damage -= state.tempHp;
                        state.tempHp = 0;
                    }
                }
                state.hp -= damage;
                if (state.hp < 0) state.hp = 0;
            } else {
                state.hp += amount;
                if (state.hp > MAX_HP) state.hp = MAX_HP;
            }
            saveState();
        }

        function modifyTempHP(amount) {
            state.tempHp = Math.max(0, state.tempHp + amount);
            saveState();
        }

        function clearTempHP() {
            state.tempHp = 0;
            saveState();
        }

        // -- DESCANSO LONGO --
        function openRestModal() {
            document.getElementById('rest-modal').classList.add('show');
        }

        function closeRestModal() {
            document.getElementById('rest-modal').classList.remove('show');
        }

        function confirmLongRest() {
            state.hp = MAX_HP;
            state.tempHp = 0;
            state.rage = [false, false, false, false];
            state.hd = [false, false, false, false, false, false, false, false];
            state.javelins = 4;
            state.deathSaves = { s: [false, false, false], f: [false, false, false] };
            saveState();
            closeRestModal();
        }

        // -- ABAS --
        function switchTab(tabId, btnElement) {
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.getElementById(`tab-${tabId}`).classList.add('active');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-emerald-400', 'active');
                btn.classList.add('text-slate-500');
            });

            if (btnElement) {
                btnElement.classList.remove('text-slate-500');
                btnElement.classList.add('text-emerald-400', 'active');
            }
        }

        // -- ROLADOR DE DADOS E ANIMAÇÃO NA TELA --
        function playDiceAnimation(finalNumber, callback) {
            const overlay = document.getElementById('dice-anim-overlay');
            const container = document.getElementById('dice-anim-container');
            
            overlay.classList.add('active');
            container.classList.remove('show-result');
            container.classList.add('bouncing');
            
            if (navigator.vibrate) navigator.vibrate(40);
            
            setTimeout(() => {
                container.classList.remove('bouncing');
                document.getElementById('dice-anim-text').innerText = finalNumber;
                container.classList.add('show-result');
                
                if (navigator.vibrate) navigator.vibrate([25, 25]);

                setTimeout(() => {
                    overlay.classList.remove('active');
                    if (callback) callback();
                }, 750);
            }, 1300);
        }

        function rollWeapon(weaponKey) {
            const d20 = Math.floor(Math.random() * 20) + 1;
            
            playDiceAnimation(d20, () => {
                const isRaging = state.rage.some(r => r === true);
                const hitTotal = d20 + HIT_BONUS;
                const rageBonus = isRaging ? 2 : 0;
                const isCrit = (d20 === 20);
                const isFumble = (d20 === 1);

                let weaponName = "Machado de Prata Sepulcral";
                let diceSides = 10;
                let dmgType = "cortante";

                if (weaponKey === 'azagaia') {
                    weaponName = "Azagaia";
                    diceSides = 6;
                    dmgType = "perfurante";
                } else if (weaponKey === 'adaga') {
                    weaponName = "Adaga";
                    diceSides = 4;
                    dmgType = "perfurante";
                }

                // Cálculo do dano
                const d1 = Math.floor(Math.random() * diceSides) + 1;
                let dmgTotal = d1 + STR_MOD + rageBonus;
                let breakdown = `1d${diceSides} (${d1}) + ${STR_MOD}${isRaging ? ' + 2 (Fúria)' : ''}`;

                if (isCrit) {
                    const d2 = Math.floor(Math.random() * diceSides) + 1;
                    dmgTotal = d1 + d2 + STR_MOD + rageBonus;
                    breakdown = `2d${diceSides} (${d1} + ${d2}) + ${STR_MOD}${isRaging ? ' + 2 (Fúria)' : ''}`;
                }

                // Montagem da Modal
                document.getElementById('modal-title').innerText = "Ataque Realizado!";
                document.getElementById('modal-weapon-name').innerText = `${weaponName} • Dano ${dmgType}`;
                document.getElementById('modal-hit-box').classList.remove('hidden');

                const hitResultEl = document.getElementById('modal-hit-result');
                const hitBreakdownEl = document.getElementById('modal-hit-breakdown');
                const dmgTitleEl = document.getElementById('modal-dmg-title');
                const dmgResultEl = document.getElementById('modal-dmg-result');
                const dmgBreakdownEl = document.getElementById('modal-dmg-breakdown');

                dmgTitleEl.innerText = `Dano (${dmgType})`;

                if (isCrit) {
                    hitResultEl.innerHTML = `CRÍTICO!`;
                    hitResultEl.className = "text-4xl font-bold text-amber-400 font-title animate-pulse";
                    hitBreakdownEl.innerText = `Rolou 20 Natural (+${HIT_BONUS} = ${hitTotal})`;
                    dmgResultEl.innerText = dmgTotal;
                    dmgBreakdownEl.innerText = breakdown;
                } else if (isFumble) {
                    hitResultEl.innerHTML = `FALHA!`;
                    hitResultEl.className = "text-4xl font-bold text-red-500 font-title";
                    hitBreakdownEl.innerText = `Rolou 1 Natural`;
                    dmgResultEl.innerText = "-";
                    dmgBreakdownEl.innerText = "O golpe errou o alvo.";
                } else {
                    hitResultEl.innerText = hitTotal;
                    hitResultEl.className = "text-4xl font-bold text-emerald-400 font-title";
                    hitBreakdownEl.innerText = `Rolou ${d20} + ${HIT_BONUS}`;
                    dmgResultEl.innerText = dmgTotal;
                    dmgBreakdownEl.innerText = breakdown;
                }

                document.getElementById('dice-modal').classList.add('show');
            });
        }

        function rollSpiritShield() {
            const d6_1 = Math.floor(Math.random() * 6) + 1;
            const d6_2 = Math.floor(Math.random() * 6) + 1;
            const total = d6_1 + d6_2;

            playDiceAnimation(total, () => {
                document.getElementById('modal-title').innerText = "Escudo Espiritual!";
                document.getElementById('modal-weapon-name').innerText = "Reação dos Guardiões Ancestrais";
                document.getElementById('modal-hit-box').classList.add('hidden'); // Oculta acerto, pois é reação de cura/redução

                document.getElementById('modal-dmg-title').innerText = "Dano Reduzido do Aliado";
                document.getElementById('modal-dmg-result').innerText = `-${total} PV`;
                document.getElementById('modal-dmg-breakdown').innerText = `Rolagem: 2d6 (${d6_1} + ${d6_2})`;

                document.getElementById('dice-modal').classList.add('show');
            });
        }

        function closeModal() {
            document.getElementById('dice-modal').classList.remove('show');
        }

        window.onload = () => {
            loadState();
        };
    </script>
